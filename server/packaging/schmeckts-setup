#!/bin/bash
# Setup window for the Schmeckt's server. Opened from the application menu.
# The actual work is done by "schmeckts-server" with administrator rights (pkexec asks for the password).
# The window's own wording is German, like the app.
TITLE="Schmeckt’s-Server"

esc() { sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }

# Run schmeckts-server as administrator; the output ends up in OUT.
# pkexec returns 126 or 127 when the password prompt is cancelled or authorisation fails; exit without a dialog.
admin() {
  OUT=$(pkexec /usr/bin/schmeckts-server "$@" 2>&1)
  local rc=$?
  if [ $rc -eq 126 ] || [ $rc -eq 127 ]; then exit 0; fi
  return $rc
}

error() { zenity --error --title="$TITLE" --width=440 --text="$(printf '%s' "$OUT" | esc)"; }

# Address and code first and large, so they are easy to copy down; the state after that
show() {
  local code addr rest
  code=$(printf '%s\n' "$OUT" | sed -n 's/^Code: *//p')
  addr=$(printf '%s\n' "$OUT" | sed -n 's/^Adresse: *//p')  # the server's output is German
  rest=$(printf '%s\n' "$OUT" | grep -v '^Code:\|^Adresse:' | sed '/^$/d' | esc)
  zenity --info --title="$TITLE" --width=440 --icon=schmeckts --ok-label="Fertig" --text="Adresse
<span size='large' weight='bold'>$(printf '%s' "$addr" | esc)</span>

Haushaltscode
<span size='xx-large' weight='bold' font_family='monospace'>$(printf '%s' "$code" | esc)</span>

$rest"
}

CHOICE=$(zenity --question --switch --title="$TITLE" --width=460 --icon=schmeckts \
  --text="Was möchtest du tun?" \
  --extra-button="Einrichten" --extra-button="Verbindungsdaten" \
  --extra-button="Übersicht" --extra-button="Neuer Code")

case "$CHOICE" in
  Einrichten)
    KEY=$(zenity --entry --hide-text --title="$TITLE" --width=480 --ok-label="Speichern" \
      --text="Anthropic-API-Schlüssel einfügen (beginnt mit sk-ant-).\nIst schon einer eingetragen und soll bleiben, das Feld leer lassen.") || exit 0
    if admin setup <<< "$KEY"; then show; else error; fi ;;
  Verbindungsdaten)
    if admin connection; then show; else error; fi ;;
  Übersicht)
    if admin overview; then
      printf '%s\n' "$OUT" | zenity --text-info --title="$TITLE: Übersicht" --width=780 --height=560 --font="Monospace 10" --ok-label="Schließen"
    else error; fi ;;
  "Neuer Code")
    zenity --question --title="$TITLE" --width=440 --ok-label="Neuen Code erzeugen" --cancel-label="Abbrechen" \
      --text="Danach funktioniert der alte Code nicht mehr. Alle Handys im Haushalt müssen den neuen Code einmal eingeben." || exit 0
    if admin setup --new-code < /dev/null; then show; else error; fi ;;
esac
