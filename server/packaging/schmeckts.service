[Unit]
Description=Schmeckt’s? household server
Documentation=man:schmeckts-server
After=network-online.target
Wants=network-online.target

[Service]
User=schmeckts
Group=schmeckts
ExecStart=/usr/bin/schmeckts-server
StateDirectory=schmeckts
StateDirectoryMode=0700
Restart=on-failure
RestartSec=3

# The service may write only to its own data directory, and may only reach the network
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
