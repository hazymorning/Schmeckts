<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: no cloud backup; device transfer takes everything but the own AI key -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="ai.json" />
        <exclude domain="file" path="ai.json.tmp" />
    </device-transfer>
</data-extraction-rules>
