<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Unverschlüsseltes http ist nur im Heimnetz erlaubt (WLAN oder WireGuard), jede andere Adresse braucht https.
         Android kann hier keine Adressbereiche ausdrücken, nur einzelne Namen. Deshalb prüft die App die Regel selbst,
         an genau einer Stelle und für jede Anfrage: normServer() in www/js/api.js. Die App lädt nichts aus dem Internet
         und spricht nur mit dem eingetragenen Server. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
